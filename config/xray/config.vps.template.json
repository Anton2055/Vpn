      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "www.microsoft.com:443",
          "xver": 0,
          "serverNames": [
            "www.microsoft.com"
          ],
          "privateKey": "KAmeXXb2EJylPb883GEFxn6JNizVpYQ-P6mlF8zIn2I",
          "shortIds": [
            "0123456789abcdef"
          ]
        }
      }
    },
    {
      "tag": "vps-vless-ws-in",
      "port": 8080,
      "listen": "127.0.0.1",
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "00000000-0000-0000-0000-000000000000",
            "level": 0
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "ws",
        "wsSettings": {
          "path": "/stream-ws-change-me"
        }
      }
    },
    {
      "tag": "vps-vless-xhttp-in",
      "port": 8081,
      "listen": "127.0.0.1",
