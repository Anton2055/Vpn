          "noSSEHeader": false
        }
      }
    },
    {
      "tag": "vps-vless-zerotier-in",
      "port": 10808,
      "listen": "0.0.0.0",
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "00000000-0000-0000-0000-000000000000",
            "level": 0
          }
        ],
        "decryption": "none"
